{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🛠️ VS Code Oturumu: Bakım Modunu Otomatik Yönet",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/set_maintenance.ps1",
        "-State",
        "auto"
      ],
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "🛠️ Site Bakım Modunu AÇ",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/set_maintenance.ps1",
        "-State",
        "on"
      ],
      "problemMatcher": []
    },
    {
      "label": "🟢 Site Bakım Modunu KAPAT (Canlıya Al)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/set_maintenance.ps1",
        "-State",
        "off"
      ],
      "problemMatcher": []
    }
  ]
}
